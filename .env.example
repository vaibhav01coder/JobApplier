# ============================================================
#  Auto-Apply config
#  Copy this file to ".env" and fill in your details.
#  .env is git-ignored — your real data never gets pushed.
#  In GitHub Actions every field below maps to a Repository Secret.
# ============================================================

# ── Wellfound login ──────────────────────────────────────────────────────────
# Use your Wellfound account email and password.
# If you signed up via Google, set these to your Google email and password.
WELLFOUND_EMAIL=you@gmail.com
WELLFOUND_PASSWORD=YourPassword123

WELLFOUND_LOGIN_URL=https://wellfound.com/login
WELLFOUND_AFTER_LOGIN_URL=https://wellfound.com/jobs

# ── Identity / contact ───────────────────────────────────────────────────────
NAME=Your Full Name
EMAIL=you@gmail.com
PHONE=9876543210
LOCATION=Hyderabad, India

# ── Profile ──────────────────────────────────────────────────────────────────
CURRENT_ROLE=Software Engineer at Company Name (City, India)
COMPANY=Company Name
EDUCATION=B.Tech, University Name (2021-2025)
YEARS_EXPERIENCE=1

# Comma-separated list of your skills
SKILLS=JavaScript, Python, React.js, Node.js, Git

# Up to 5 resume highlights separated by ||
HIGHLIGHTS=Built scalable REST APIs handling 1000+ concurrent requests||Led frontend migration to React.js improving load time by 40%

# ── Application answers ───────────────────────────────────────────────────────
NOTICE_PERIOD=30 days
CURRENT_CTC=8
EXPECTED_CTC=12
DOB=DD/MM/YYYY
GENDER=Male
WORK_AUTH=Authorized to work in my country of residence.

# ── Profile links ─────────────────────────────────────────────────────────────
GITHUB_URL=https://github.com/yourusername
LINKEDIN_URL=https://www.linkedin.com/in/yourprofile/
PORTFOLIO_URL=

# ── Bot behaviour ─────────────────────────────────────────────────────────────
TARGET_LOCATIONS=India||Hyderabad||Bengaluru||Bangalore||Pune||Mumbai||Delhi NCR||Remote India
MIN_SKILL_MATCHES=1
MIN_APPLY_TARGET=20
MAX_APPLICATIONS=50
MAX_SCAN_JOBS=150
APPLY_LIVE=false
APPLICATIONS_CSV=applications-wellfound.csv
LOG_DRY_RUN_TO_CSV=true

# ── Optional: Naukri profile refresh ─────────────────────────────────────────
NAUKRI_PROFILE_URL=https://www.naukri.com/mnjuser/profile
GOOGLE_EMAIL=you@gmail.com
GOOGLE_PASSWORD=YourGooglePassword

# ── Optional: Gemini API key for AI-answered questions ───────────────────────
# Get a free key at https://aistudio.google.com/apikey
GEMINI_KEY=
